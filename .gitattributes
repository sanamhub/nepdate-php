* text=auto eol=lf
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.tsv text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.png binary
/shared/** -diff linguist-generated=true
/src/Internal/*.php linguist-generated=true
/packages/nepdate-patro/src/Internal/*.php linguist-generated=true

# What a Composer archive leaves out: the released package needs its source, its manifest, the
# licence, the notice, the readme and the changelog, and nothing else (ADR-0007). The patro
# package has its own .gitattributes, because its archive is built from packages/nepdate-patro.
/tests export-ignore
/.github export-ignore
/docs export-ignore
/bench export-ignore
/shared export-ignore
/scripts export-ignore
/packages export-ignore
/phpstan.neon export-ignore
/.php-cs-fixer.php export-ignore
/phpunit.xml export-ignore
/infection.json5 export-ignore
/composer.lock export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
