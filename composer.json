{
    "name": "sanamhub/nepdate",
    "description": "Bikram Sambat (Nepali) dates for PHP: conversion, arithmetic, formatting, parsing and ranges, ported from the C# NepDate reference implementation.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0-rc.1",
    "homepage": "https://github.com/sanamhub/nepdate-php",
    "keywords": [
        "nepali-date",
        "bikram-sambat",
        "bs-date",
        "nepali-calendar",
        "date"
    ],
    "authors": [
        {
            "name": "Sanam Pakuwal",
            "homepage": "https://github.com/sanamhub"
        }
    ],
    "support": {
        "issues": "https://github.com/sanamhub/nepdate-php/issues",
        "source": "https://github.com/sanamhub/nepdate-php"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.27",
        "infection/infection": "0.35.8",
        "justinrainbow/json-schema": "6.14.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "2.3.1",
        "phpunit/phpunit": "12.5.40",
        "sanamhub/nepdate-patro": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/nepdate-patro",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "NepDate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NepDate\\Tests\\": "tests/",
            "NepDate\\Patro\\Tests\\": "packages/nepdate-patro/tests/",
            "NepDate\\Bench\\": "bench/"
        }
    },
    "scripts": {
        "codegen": [
            "php scripts/generate-tables.php",
            "php packages/nepdate-patro/scripts/generate-patro-tables.php"
        ],
        "codegen:check": [
            "php scripts/generate-tables.php --check",
            "php packages/nepdate-patro/scripts/generate-patro-tables.php --check"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "docs:check": "php scripts/docs-check.php",
        "ci": [
            "@codegen:check",
            "@cs",
            "@stan",
            "@docs:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
